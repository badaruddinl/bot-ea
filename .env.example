# GOLDM demo-only deployment template.
#
# bootstrap-goldm-windows-vm.ps1 copies this file only when no source .env
# exists, then stops. Replace every UNSET value and verify the exact terminal
# paths before rerunning bootstrap. Never add an MT5 password to this file.

TELEGRAM_BOT_TOKEN="UNSET"
TELEGRAM_CHAT_ID="UNSET"
TELEGRAM_ADMIN_CHAT_IDS="UNSET"
GOLDM_SIGNAL_DB="runtime_data/goldm_signal.db"

# Exact standard (non-portable) MT5 installation and data directory.
MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
MT5_DATA_PATH="C:\Users\UNSET\AppData\Roaming\MetaQuotes\Terminal\UNSET"
MT5_LAUNCH_MODE="standard"

# These four values must describe the same manually authenticated DEMO account.
MT5_LOGIN="UNSET"
MT5_SERVER="UNSET"
GOLDM_EXPECTED_MT5_LOGIN="UNSET"
GOLDM_EXPECTED_MT5_SERVER="UNSET"

# Generate a unique 16-96 character token for each EA/runtime session.
GOLDM_EA_SESSION_ID="UNSET"

# Immutable deployment kill switch. The sealed deployment validator rejects
# any value other than exactly false and rejects REAL/CONTEST/unknown accounts.
GOLDM_ALLOW_LIVE_ACTIVATION="false"
GOLDM_TRADE_LIFECYCLE_ENABLED="true"
GOLDM_EXECUTION_MODE="off"

# The production strategy engine remains the frozen 1.72 ALL engine. These are
# independent runtime entry and notification policies, not engine selectors.
GOLDM_ENTRY_SIDE_POLICY="ALL"
GOLDM_NOTIFICATION_SIDE_FILTER="ALL"

# MT5 event-time compatibility fallback for legacy log lines only.
MT5_SERVER_UTC_OFFSET_MINUTES="180"

GOLDM_RISK_PCT="0.5"
GOLDM_MAX_OPEN_RISK_PCT="1.0"
GOLDM_DAILY_LOSS_LIMIT_PCT="2.0"
GOLDM_SIGNAL_TTL_MINUTES="5"
GOLDM_MAX_ENTRY_DRIFT_R="0.15"
GOLDM_MAGIC="260814"
