TELEGRAM_BOT_TOKEN="TOKEN_DARI_BOTFATHER"
TELEGRAM_CHAT_ID="CHAT_ID_ADMIN_UTAMA"
TELEGRAM_ADMIN_CHAT_IDS="CHAT_ID_ADMIN_UTAMA"
GOLDM_SIGNAL_DB="runtime_data/goldm_signal.db"

# MT5 event-time contract. New EA logs carry UTC epochs; this offset is only a
# compatibility fallback for old logs. Example XM summer server time: UTC+3 = 180.
MT5_SERVER_UTC_OFFSET_MINUTES="180"

# Trade lifecycle is opt-in and independent from Telegram subscriber approval.
GOLDM_TRADE_LIFECYCLE_ENABLED="false"
GOLDM_EXECUTION_MODE="off" # off | demo | live
GOLDM_RISK_PCT="0.5"
GOLDM_MAX_OPEN_RISK_PCT="1.0"
GOLDM_DAILY_LOSS_LIMIT_PCT="2.0"
GOLDM_SIGNAL_TTL_MINUTES="5"
GOLDM_MAX_ENTRY_DRIFT_R="0.15"
GOLDM_MAGIC="260814"

# Optional terminal/account pinning. Required for live mode.
MT5_PATH=""
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""
GOLDM_EXPECTED_MT5_LOGIN=""
GOLDM_EXPECTED_MT5_SERVER=""

# Live mode additionally requires this exact acknowledgement. Never copy it to
# production until the account, risk policy, and broker behavior are verified.
GOLDM_LIVE_ORDER_CONSENT=""
